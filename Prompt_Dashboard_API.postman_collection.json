				"body": {
					"mode": "raw",
					"raw": "{\n    \"sql\": \"SELECT column_name, data_type, is_nullable FROM information_schema.columns WHERE table_schema = 'public' ORDER BY table_name, ordinal_position LIMIT 50\"\n}"
				},
